{
  "name": "aiamigos-static",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "content:check": "node scripts/check-content.mjs",
    "content:import:legacy": "node scripts/import-snapshot.mjs",
    "build": "npm run evidence:release && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test:unit": "npm run evidence:release && node --test tests/*.test.mjs",
    "test:migrations": "node --test tests/supabase-migrations.integration.test.mjs",
    "test": "npm run test:unit && node scripts/verify-static-site.mjs",
    "feeds:sync": "node scripts/sync-feeds.mjs",
    "graph:check": "node scripts/check-graph-artifact.mjs",
    "graph:update": "graphify update .",
    "evidence:release": "node scripts/generate-evidence-release.mjs",
    "evidence:export:counsel": "node scripts/export-counsel-evidence.mjs",
    "deploy:hostinger:prepare": "node scripts/prepare-hostinger-deploy.mjs",
    "deploy:hostinger": "node scripts/deploy-hostinger.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "^7.2.4",
    "pagefind": "^1.4.0",
    "ssh2-sftp-client": "^12.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
