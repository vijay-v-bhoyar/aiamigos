    "raw": "[sirat-pro-services]",
    "rendered": "<div class=\"row services-short\" id=\"our-services\"><div class=\"col-lg-3 col-md-6 col-sm-6\">\n                        <div class=\"our-services-box\">\n                          <div class=\"services-icon\">\n                            <img decoding=\"async\" class=\"services-img\" src=\"http://remediation.aiamigos.org/wp-content/uploads/2023/10/DALL·E-2023-11-08-12.13.57-Create-a-colorful-and-engaging-illustration-suitable-for-a-childrens-book-cover-titled-AI-for-Kids.-The-scene-should-include-a-friendly-robot-sitt.png\" alt=\"AI for Kids post thumbnail\"/>\n                          </div>\n                          <h5 class=\"services_name\">\n                            <a href=\"https://remediation.aiamigos.org/services/ai-for-kids/\">AI for Kids</a>\n                          </h5>\n                          <div class=\"services-text\">AI for Kids (Junior) We make learning about Artificial Intelligence (AI) fun and easy for&hellip;</div>\n                          <a href=\"https://remediation.aiamigos.org/services/ai-for-kids/\">\n                            <i class=\"fas fa-arrow-circle-right\"></i><span class=\"screen-reader-text\">Service Url</span>\n                          </a>\n                        </div>\n                      </div><div class=\"col-lg-3 col-md-6 col-sm-6\">\n                        <div class=\"our-services-box\">\n                          <div class=\"services-icon\">\n                            <img decoding=\"async\" class=\"services-img\" src=\"https://remediation.aiamigos.org/wp-content/themes/sirat-pro/assets/images/services/Service1.webp\" alt=\"AI Amigos Academy post thumbnail\"/>\n                          </div>\n                          <h5 class=\"services_name\">\n                            <a href=\"https://remediation.aiamigos.org/services/ai-amigos-academy/\">AI Amigos Academy</a>\n                          </h5>\n                          <div class=\"services-text\">At AI Amigos Acade