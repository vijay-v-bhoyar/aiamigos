---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { site } from '../data/site';
import BrandMark from '../components/BrandMark.astro';
import { tracks } from '../data/tracks.mjs';

const { title = site.name, description = site.description, canonical, image = '/social-card.svg', schema, robots = 'index,follow', pageClass = '' } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const umamiSiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(image, site.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site.url)} />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="AI Amigos articles" href="/rss.xml" />
    <title>{pageTitle}</title>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {umamiSiteId && <script async defer data-website-id={umamiSiteId} src="https://analytics.aiamigos.org/script.js"></script>}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/"><BrandMark /></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation"><span class="sr-only">Open navigation</span><span></span><span></span><span></span></button>
        <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation">
          <div class="nav-primary">{site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}</div>
          <details class="track-switcher"><summary>Use AI for…</summary><div class="track-menu">{tracks.map((track) => <a href={`/tracks/${track.slug}/`}><strong>{track.label}</strong><small>{track.short}</small></a>)}</div></details>
          <div class="nav-actions"><a href="/search/" aria-label="Search AI Amigos">Search</a><a class="account-link" href="/account/">Sign in</a></div>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <BrandMark />
          <p>{site.description}</p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/app/">Workbench</a></li>
            <li><a href="/endeavor/">Public endeavor</a></li>
            <li><a href="/methods/">Versioned methods</a></li>
            <li><a href="/methods/examples/">Synthetic examples</a></li>
            <li><a href="/participate/">Participate</a></li>
            <li><a href="/evidence/">Evidence ledger</a></li>
            <li><a href="/field-studies/">Field studies</a></li>
            <li><a href="/adoption/">Adoption registry</a></li>
            <li><a href="/outcomes/">Outcome registry</a></li>
            <li><a href="/benchmarks/">Benchmarks</a></li>
            <li><a href="/research/">Research registry</a></li>
          </ul>
        </div>
        <div>
          <h2>Trust</h2>
          <ul>
            <li><a href="/about/">Editorial standards</a></li>
            <li><a href="/reviews/">Review registry</a></li>
            <li><a href="/reviews/kit/">Reviewer kit</a></li>
            <li><a href="/releases/v0.1.1/">Release v0.1.1</a></li>
            <li><a href="/timeline/">Public timeline</a></li>
            <li><a href="/corrections/">Corrections</a></li>
            <li><a href="/data-policy/">Evidence data policy</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('.nav-toggle');
      const navigation = document.querySelector('#primary-navigation');
      const closeNavigation = () => { toggle?.setAttribute('aria-expanded', 'false'); navigation?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        navigation?.classList.toggle('is-open', open);
      });
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeNavigation(); toggle?.focus(); } });
      matchMedia('(min-width: 961px)').addEventListener('change', (event) => { if (event.matches) closeNavigation(); });
    </script>
  </body>
</html>
