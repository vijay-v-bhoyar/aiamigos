---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CollectionFilters from '../../components/CollectionFilters.astro';
import { guideReviewQueue } from '../../data/guide-review-queue.mjs';
const published = await getCollection('articles', ({data}) => data.status === 'published');
const articles = published.filter(({data}) => data.reviewStatus === 'reviewed').sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt));
const quarantinedCount = published.length - articles.length;
const categories=[...new Set(articles.map((item)=>item.data.category))].sort();
---
<BaseLayout title="Reviewed AI guides" description="Evidence-gated decision support for business, careers, teaching, and technical AI practice.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Reviewed guides</p><h1>Decision support that has passed the evidence gate.</h1><p class="lede">A guide appears here only after it has a distinct job, worked example, useful artifact, two authoritative sources, named ownership, dates, limitations, and change history.</p></section>
  {articles.length ? <CollectionFilters id="guide-browser" total={articles.length} singular="reviewed guide" plural="reviewed guides" searchLabel="Find by title or task" searchPlaceholder="RAG, policy, career…" filters={[{name:'category',label:'Topic',allLabel:'All topics',options:categories.map((category)=>({value:category,label:category}))},{name:'difficulty',label:'Difficulty',allLabel:'Any level',options:['beginner','intermediate','advanced'].map((difficulty)=>({value:difficulty,label:difficulty}))}]}><div id="guide-grid" class="article-grid" data-filter-results>{articles.map((article)=><div data-filter-item data-search={`${article.data.title} ${article.data.description}`} data-category={article.data.category} data-difficulty={article.data.difficulty}><ArticleCard article={article}/></div>)}</div></CollectionFilters> : <section class="empty-library"><span class="status pending">Editorial gate active</span><h2>No legacy guide is being presented as reviewed.</h2><p>{quarantinedCount} historical article routes remain available for provenance, but they are excluded from search and discovery until each passes the current source and review standard.</p><div class="button-row"><a class="button" href="/playbooks/">Use a reviewed protocol</a><a class="button secondary" href="/app/">Start a project</a></div></section>}
  <section class="section-space"><div class="section-head"><div><p class="eyebrow">First editorial batch</p><h2>16 guides are queued, not quietly relabeled.</h2></div></div><div class="record-table" role="region" aria-label="Guide review queue" tabindex="0"><table><thead><tr><th>Proposed guide</th><th>Track</th><th>Status</th><th>Remaining gate</th></tr></thead><tbody>{guideReviewQueue.map((item)=><tr><td>{item.title}</td><td>{item.track}</td><td><span class="status pending">{item.status}</span></td><td>{item.gate}</td></tr>)}</tbody></table></div></section>
  </div>
</BaseLayout>
