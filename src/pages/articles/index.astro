---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import ArticleCard from '../../components/ArticleCard.astro';
const articles=(await getCollection('articles',({data})=>data.status==='published')).sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt));
const categories=[...new Set(articles.map((item)=>item.data.category))].sort();
---
<BaseLayout title="Practical AI guides" description="Filter the AI Amigos guide library by task area, difficulty, freshness, and practical resource connection."><div class="shell"><div class="reading"><p class="eyebrow">Guides library</p><h1>Use a guide to make a decision or complete a task.</h1><p class="lede">Historical routes remain available. A “source-preserved” label means the original date is intact but the guide has not yet passed the current review gate.</p></div><form id="guide-filters" class="filter-bar"><label>Find by title or task<input name="query" type="search" placeholder="RAG, policy, career…" /></label><label>Topic<select name="category"><option value="">All topics</option>{categories.map((category)=><option value={category}>{category}</option>)}</select></label><label>Difficulty<select name="difficulty"><option value="">Any level</option><option>beginner</option><option>intermediate</option><option>advanced</option></select></label><label>Review status<select name="review"><option value="">Any status</option><option value="source-preserved">Source-preserved</option><option value="reviewed">Reviewed</option></select></label></form><p id="guide-count" class="meta">{articles.length} guides</p><div id="guide-grid" class="article-grid">{articles.map((article)=><div data-title={`${article.data.title} ${article.data.description}`.toLowerCase()} data-category={article.data.category} data-difficulty={article.data.difficulty} data-review={article.data.reviewStatus}><ArticleCard article={article}/></div>)}</div></div><script>
const form=document.querySelector('#guide-filters'),cards=[...document.querySelectorAll('#guide-grid>[data-title]')],count=document.querySelector('#guide-count');function filter(){const value=Object.fromEntries(new FormData(form));let shown=0;cards.forEach((card)=>{const visible=(!value.query||card.dataset.title.includes(value.query.toLowerCase()))&&(!value.category||card.dataset.category===value.category)&&(!value.difficulty||card.dataset.difficulty===value.difficulty)&&(!value.review||card.dataset.review===value.review);card.hidden=!visible;if(visible)shown++;});count.textContent=`${shown} guide${shown===1?'':'s'}`;}form.addEventListener('input',filter);
</script></BaseLayout>
