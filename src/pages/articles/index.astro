---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { guideReviewQueue } from '../../data/guide-review-queue.mjs';
const published = await getCollection('articles', ({data}) => data.status === 'published');
const articles = published.filter(({data}) => data.reviewStatus === 'reviewed').sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt));
const quarantinedCount = published.length - articles.length;
const categories=[...new Set(articles.map((item)=>item.data.category))].sort();
---
<BaseLayout title="Reviewed AI guides" description="Evidence-gated decision support for business, careers, teaching, and technical AI practice.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Reviewed guides</p><h1>Decision support that has passed the evidence gate.</h1><p class="lede">A guide appears here only after it has a distinct job, worked example, useful artifact, two authoritative sources, named ownership, dates, limitations, and change history.</p></section>
  {articles.length ? <><form id="guide-filters" class="filter-bar"><label>Find by title or task<input name="query" type="search" placeholder="RAG, policy, career…" /></label><label>Topic<select name="category"><option value="">All topics</option>{categories.map((category)=><option value={category}>{category}</option>)}</select></label><label>Difficulty<select name="difficulty"><option value="">Any level</option><option>beginner</option><option>intermediate</option><option>advanced</option></select></label><label>Evidence<select name="review"><option value="reviewed">Reviewed only</option></select></label></form><p id="guide-count" class="meta">{articles.length} reviewed guides</p><div id="guide-grid" class="article-grid">{articles.map((article)=><div data-title={`${article.data.title} ${article.data.description}`.toLowerCase()} data-category={article.data.category} data-difficulty={article.data.difficulty}><ArticleCard article={article}/></div>)}</div></> : <section class="empty-library"><span class="status pending">Editorial gate active</span><h2>No legacy guide is being presented as reviewed.</h2><p>{quarantinedCount} historical article routes remain available for provenance, but they are excluded from search and discovery until each passes the current source and review standard.</p><div class="button-row"><a class="button" href="/playbooks/">Use a reviewed protocol</a><a class="button secondary" href="/app/">Start a project</a></div></section>}
  <section class="section-space"><div class="section-head"><div><p class="eyebrow">First editorial batch</p><h2>16 guides are queued, not quietly relabeled.</h2></div></div><div class="record-table" role="region" aria-label="Guide review queue" tabindex="0"><table><thead><tr><th>Proposed guide</th><th>Track</th><th>Status</th><th>Remaining gate</th></tr></thead><tbody>{guideReviewQueue.map((item)=><tr><td>{item.title}</td><td>{item.track}</td><td><span class="status pending">{item.status}</span></td><td>{item.gate}</td></tr>)}</tbody></table></div></section>
  </div>
  {articles.length > 0 && <script>
    const form=document.querySelector('#guide-filters'),cards=[...document.querySelectorAll('#guide-grid>[data-title]')],count=document.querySelector('#guide-count');
    const filter=()=>{const value=Object.fromEntries(new FormData(form));let shown=0;cards.forEach((card)=>{const visible=(!value.query||card.dataset.title.includes(value.query.toLowerCase()))&&(!value.category||card.dataset.category===value.category)&&(!value.difficulty||card.dataset.difficulty===value.difficulty);card.hidden=!visible;if(visible)shown++;});count.textContent=`${shown} reviewed guide${shown===1?'':'s'}`;}; form.addEventListener('input',filter);
  </script>}
</BaseLayout>
