---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { benchmarkDefinitions, MIN_BENCHMARK_SAMPLE, MIN_BENCHMARK_ORGANIZATIONS } from '../../data/outcome-network.mjs';
---
<BaseLayout title="AI practice benchmarks" description="Privacy-thresholded benchmark methodology for comparable, human-reviewed AI workflow outcomes.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Outcome benchmarks</p><h1>No chart until the cohort deserves one.</h1><p class="lede">AI Amigos publishes a benchmark only when at least {MIN_BENCHMARK_SAMPLE} comparable reports from at least {MIN_BENCHMARK_ORGANIZATIONS} independent organizations pass privacy and editorial review. Zero reports currently qualify.</p></section>
  <section class="benchmark-method"><div><h2>Publication gate</h2><ol><li>Same task definition and metric</li><li>Known version and date window</li><li>At least {MIN_BENCHMARK_SAMPLE} reviewed reports</li><li>At least {MIN_BENCHMARK_ORGANIZATIONS} independent organizations</li><li>No organization supplies more than half the cohort</li><li>No direct or quasi-identifiers</li><li>Median and interquartile range</li><li>Named reviewer, limitations, and corrections</li></ol></div><div class="suppression-panel"><span class="status pending">All cohorts suppressed</span><strong>0 publishable benchmarks</strong><p>Collection is not evidence. Review, comparability, independence, concentration, and privacy gates must all pass.</p></div></section>
  <h2>Collection status</h2><div class="record-table" role="region" aria-label="Benchmark collection status" tabindex="0"><table><thead><tr><th>Task</th><th>Track</th><th>Metric</th><th>Reports</th><th>Organizations</th><th>Status</th></tr></thead><tbody>{benchmarkDefinitions.map((item) => <tr><td>{item.task}</td><td>{item.track}</td><td>{item.metric}</td><td>{item.sampleCount}/{MIN_BENCHMARK_SAMPLE}</td><td>{item.independentOrganizationCount}/{MIN_BENCHMARK_ORGANIZATIONS}</td><td><span class="status pending">Suppressed</span></td></tr>)}</tbody></table></div><p class="meta">Method: <a href="/methods/comparable-outcome-benchmark-method/">Comparable Outcome Benchmark Method 0.1.0</a>.</p></div>
</BaseLayout>
