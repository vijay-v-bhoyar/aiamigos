---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { site } from '../../data/site';
const actions=[['Suggest a correction','Correction'],['Report a broken tool','Broken tool'],['Verify an adoption','Adoption verification'],['Propose a field study','Governed pilot proposal'],['Propose an external review','Independent review proposal'],['Submit an external citation','External citation'],['Suggest a source','Source suggestion'],['Request a practical tool','Tool request']];
---
<BaseLayout title="Contact and evidence submissions" description="Send a correction, verification, review proposal, source, field-study request, or broken-tool report."><div class="shell"><div class="reading"><p class="eyebrow">Corrections and verification</p><h1>Help test the record.</h1><p class="lede">The static site does not collect a form submission. Choose an action to open your own email application. A message is not published or counted as evidence without verification, consent, privacy review, and a human publication decision.</p><p class="notice"><strong>Protect your privacy:</strong> do not include passwords, confidential work, student records, medical or financial data, employer secrets, raw prompts, or other personal information.</p></div><div class="track-grid section-space">{actions.map(([label,subject])=><a class="work-card" href={`mailto:${site.email}?subject=AI%20Amigos%20-%20${encodeURIComponent(subject)}`}><h2>{label}</h2><p>Include the relevant page or method version, bounded factual statement, outside verification link, relationship disclosure, and only non-sensitive evidence.</p><span class="text-link">Email {site.email} →</span></a>)}</div></div></BaseLayout>
