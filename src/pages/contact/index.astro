---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { site } from '../../data/site';
const actions=[['Suggest a correction','Correction'],['Report a broken tool','Broken tool'],['Suggest a source','Source suggestion'],['Request a practical tool','Tool request']];
---
<BaseLayout title="Contact and corrections" description="Send an AI Amigos correction, broken-tool report, source suggestion, or practical tool request."><div class="shell"><div class="reading"><p class="eyebrow">Help improve the workbench</p><h1>Report what needs attention.</h1><p class="lede">The static site does not collect a form submission. Choose an action to open your own email application.</p><p class="notice"><strong>Protect your privacy:</strong> do not include passwords, confidential work, student records, medical or financial data, or other personal information.</p></div><div class="track-grid section-space">{actions.map(([label,subject])=><a class="work-card" href={`mailto:${site.email}?subject=AI%20Amigos%20—%20${encodeURIComponent(subject)}`}><h2>{label}</h2><p>Include the page address, what you expected, what happened, and non-sensitive evidence.</p><span class="text-link">Email {site.email} →</span></a>)}</div></div></BaseLayout>
