---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fieldStudies } from '../../data/evidence-platform.mjs';
---
<BaseLayout title="AI field studies" description="Predefined, versioned field studies measuring AI workflow quality, cost, risk, human intervention, and follow-up outcomes.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Field evidence</p><h1>Measure before, during, and after AI enters the workflow.</h1><p class="lede">A field study needs a baseline, fixed method version, real follow-up outcome, privacy review, limitations, and independently verifiable participation.</p></section>
  {fieldStudies.length ? <div class="record-table"><table><thead><tr><th>Study</th><th>Method</th><th>Participants</th><th>Status</th></tr></thead><tbody>{fieldStudies.map((study) => <tr><td>{study.title}</td><td>{study.methodVersion}</td><td>{study.participantCount}</td><td>{study.status}</td></tr>)}</tbody></table></div> : <section class="empty-evidence"><span class="status pending">0 publishable studies</span><h2>No field study has passed the evidence gate.</h2><p>AI Amigos will not convert planned pilots, private conversations, generated examples, or protocol demonstrations into public impact claims.</p><div class="button-row"><a class="button" href="/methods/">Inspect the methods</a><a class="button secondary" href="/contact/">Propose a governed pilot</a></div></section>}
  <section class="section-space"><h2>Required field-study record</h2><div class="requirement-grid"><article><strong>1. Pre-registration</strong><p>Job, baseline, sample, metric, owner, success criterion, stop criterion, method version.</p></article><article><strong>2. Comparable execution</strong><p>Fixed cases, system versions, cost, latency, failures, human overrides, deviations.</p></article><article><strong>3. Follow-up outcome</strong><p>Observed result after use, date window, confounders, limitations, reversals.</p></article><article><strong>4. Verification</strong><p>Consent, privacy decision, reviewer scope, evidence hash, outside corroboration.</p></article></div></section></div>
</BaseLayout>
