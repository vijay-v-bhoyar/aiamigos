---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { methods, evidenceTierById } from '../../../data/evidence-platform.mjs';
export function getStaticPaths() { return methods.map((method) => ({ params: { slug: method.slug }, props: { method } })); }
const { method } = Astro.props;
const schema = { '@context':'https://schema.org', '@type':'TechArticle', headline:method.title, description:method.summary, datePublished:method.releasedAt, dateModified:method.changeLog.at(-1)?.date ?? method.releasedAt, version:method.version, author:{ '@type':'Person', name:method.author, url:'https://www.aiamigos.org/about/vijay-bhoyar/' }, publisher:{ '@type':'Organization', name:'AI Amigos', url:'https://www.aiamigos.org/' }, mainEntityOfPage:`https://www.aiamigos.org/methods/${method.slug}/` };
---
<BaseLayout title={`${method.title} ${method.version}`} description={method.summary} schema={schema}>
  <div class="shell"><section class="article-header reading"><p class="eyebrow">Working specification</p><h1>{method.title}</h1><p class="lede">{method.summary}</p><dl class="metadata"><div><dt>Version</dt><dd>{method.version}</dd></div><div><dt>Author</dt><dd><a href="/about/vijay-bhoyar/">{method.author}</a></dd></div><div><dt>Released</dt><dd>{method.releasedAt}</dd></div><div><dt>Next review</dt><dd>{method.nextReviewAt}</dd></div></dl><div class="evidence"><strong>{evidenceTierById[method.evidenceTier].label}.</strong> {evidenceTierById[method.evidenceTier].description} {method.originalityStatus}</div></section>
  <div class="article-layout section-space"><article class="reading"><h2>Job to be done</h2><p>{method.jobToBeDone}</p><h2>Required inputs</h2><ul class="check-list">{method.requiredInputs.map((item) => <li>{item}</li>)}</ul><h2>Procedure</h2><ol class="method-steps">{method.steps.map((step) => <li>{step}</li>)}</ol><h2>Outputs</h2><ul>{method.outputs.map((item) => <li>{item}</li>)}</ul><h2>Publication gate</h2><p>A result remains private or draft until every applicable gate passes.</p><ul class="check-list">{method.publicationGate.map((item) => <li>{item}</li>)}</ul><h2>Limitations</h2><ul>{method.limitations.map((item) => <li>{item}</li>)}</ul><h2>Sources and prior-art context</h2><p>These sources inform the working synthesis. Their inclusion does not imply endorsement.</p><ul>{method.sources.map((source) => <li><a href={source.url} rel="external">{source.title}</a> - {source.publisher}</li>)}</ul><h2>Change history</h2><ul>{method.changeLog.map((change) => <li><strong>{change.date}</strong> - {change.summary}</li>)}</ul></article><aside class="evidence-ledger"><h2>Use and verify</h2><dl><div><dt>Status</dt><dd>{method.status}</dd></div><div><dt>Evidence tier</dt><dd>{evidenceTierById[method.evidenceTier].label}</dd></div><div><dt>Adoptions</dt><dd>0 verified</dd></div><div><dt>Outcome reports</dt><dd>0 reviewed</dd></div><div><dt>External citations</dt><dd>0 verified</dd></div></dl><h3>Inspect the fixture</h3><p><a href={`/methods/examples/${method.exampleSlug}/`}>Open synthetic example</a></p><h3>Download schemas</h3><p><a href="/schemas/workflow-evidence-record.schema.json">Workflow record JSON Schema</a></p><p><a href="/schemas/public-evidence-record.schema.json">Public evidence JSON Schema</a></p><h3>Next action</h3><p><a href="/participate/">Run a governed pilot</a></p><p><a href="/reviews/kit/">Review this method</a></p><p><a href="/contact/">Submit a correction</a></p></aside></div></div>
</BaseLayout>
