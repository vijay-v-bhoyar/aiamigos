---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { methodExamples, pilotReadyRelease } from '../../../data/pilot-ready-release.mjs';
---
<BaseLayout title="Synthetic method examples" description="Downloadable, schema-validated examples showing how AI Amigos methods behave without presenting invented adoption or outcome evidence.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Synthetic fixtures · {pilotReadyRelease.id}</p><h1>See the methods work before using real evidence.</h1><p class="lede">Each example is intentionally fictional, downloadable, schema validated, checksum-bound in the release manifest, and excluded from the adoption, outcome, review, and citation registries.</p><div class="notice"><strong>Evidence boundary:</strong> {pilotReadyRelease.nonClaim}</div></section>
  <div class="method-list">{methodExamples.map((example, index) => <article class="method-row"><div class="method-number">0{index + 1}</div><div><span class="status pending">synthetic · non-evidentiary</span><h2><a href={`/methods/examples/${example.slug}/`}>{example.title}</a></h2><p>{example.summary}</p><p class="meta">{example.expectedValidation}</p></div><a class="text-link" href={`/methods/examples/${example.slug}/`}>Inspect fixture →</a></article>)}</div>
  <section class="split-section section-space"><div><h2>Ready to test a real workflow?</h2><p>Use a governed pilot package. Keep working data private and choose publication consent only after review.</p><a href="/participate/">Open participation kit →</a></div><div><h2>Verify the artifact</h2><p>Use the immutable path, byte count, and SHA-256 digest in the release manifest.</p><a href="/releases/v0.1.1/">Open release manifest →</a></div></section></div>
</BaseLayout>
