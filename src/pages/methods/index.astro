---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { methods, evidenceTierById } from '../../data/evidence-platform.mjs';
---
<BaseLayout title="Versioned AI practice methods" description="Operational, versioned methods for AI workflow evidence, privacy-safe proof packs, and comparable outcome benchmarks.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Versioned methods</p><h1>Methods you can inspect, test, and challenge.</h1><p class="lede">Each working specification exposes its inputs, steps, outputs, publication gate, limitations, sources, version, and change history.</p><div class="notice"><strong>Current status:</strong> all methods are author controlled. Independent use, originality, major significance, and external recognition are not claimed.</div></section>
  <div class="method-list">{methods.map((method, index) => <article class="method-row"><div class="method-number">0{index + 1}</div><div><span class="status pending">{method.status}</span><h2><a href={`/methods/${method.slug}/`}>{method.title}</a></h2><p>{method.summary}</p><dl class="inline-facts"><div><dt>Version</dt><dd>{method.version}</dd></div><div><dt>Released</dt><dd>{method.releasedAt}</dd></div><div><dt>Evidence</dt><dd>{evidenceTierById[method.evidenceTier].label}</dd></div></dl></div><a class="text-link" href={`/methods/${method.slug}/`}>Open method →</a></article>)}</div>
  <section class="split-section section-space"><div><h2>Use a method</h2><p>Start with a local project, freeze a baseline and evaluation set, and export the resulting record without sending private inputs to AI Amigos.</p><a href="/app/">Start in the workbench →</a></div><div><h2>Review or replicate</h2><p>Use the published schema, document deviations, and send a non-sensitive correction or independent verification link.</p><a href="/contact/">Propose a review or replication →</a></div></section></div>
</BaseLayout>
