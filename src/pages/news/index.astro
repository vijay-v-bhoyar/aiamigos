---
import BaseLayout from '../../layouts/BaseLayout.astro'; import feeds from '../../data/feed-sources.json'; import cache from '../../data/feed-cache.json';
---
<BaseLayout title="AI news and newsletter issues" description="Validated AI Amigos newsletter and digital-newspaper metadata connected to evergreen practical resources."><div class="shell"><div class="reading"><p class="eyebrow">News connected to practice</p><h1>AI news is useful when it leads to a better decision.</h1><p class="lede">This hub will show validated issue metadata and link to the original publication—never copy full feed content.</p></div>{cache.items.length ? <div class="article-grid section-space">{cache.items.map((item)=><article class="article-card"><span class="tag">{item.source}</span><h2><a href={item.url} rel="external">{item.title}</a></h2><p>{item.summary}</p><p class="meta">{item.publishedAt}</p></article>)}</div> : <div class="notice section-space"><strong>Feeds are not connected yet.</strong> The newsletter and digital newspaper sources remain deliberately inactive until their URLs and domains are approved. No stale or unvalidated feed is presented as current.</div>}<section class="reading section-space"><h2>Configured sources</h2><ul>{feeds.map((feed)=><li><strong>{feed.name}</strong> — {feed.enabled?'enabled':'inactive pending URL'}</li>)}</ul><p class="meta">Last successful refresh: {cache.lastSuccessfulAt ?? 'none yet'}</p><p><a href="/newsletter/">Newsletter and subscription status</a></p></section></div></BaseLayout>
