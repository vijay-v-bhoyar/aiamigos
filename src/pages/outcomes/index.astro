---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { verifiedOutcomes } from '../../data/evidence-platform.mjs';
---
<BaseLayout title="Reviewed outcome registry" description="Measured, privacy-reviewed AI workflow outcomes with visible baselines, calculations, limitations, and human decisions.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Outcome registry</p><h1>An offline score is not a real-world outcome.</h1><p class="lede">Every outcome must show its baseline, result, unit, window, method version, human decision, privacy status, reviewer, and limitations.</p></section>
  {verifiedOutcomes.length ? <div class="record-table"><table><thead><tr><th>Outcome</th><th>Baseline</th><th>Result</th><th>Review</th></tr></thead><tbody>{verifiedOutcomes.map((item) => <tr><td>{item.title}</td><td>{item.baseline.value} {item.baseline.unit}</td><td>{item.result.value} {item.result.unit}</td><td>{item.status}</td></tr>)}</tbody></table></div> : <section class="empty-evidence"><span class="status pending">0 reviewed outcomes</span><h2>No outcome is public yet.</h2><p>Protocol examples, generated text, local projects, and planned pilots remain outside this registry.</p><div class="button-row"><a class="button" href="/app/">Record a private project</a><a class="button secondary" href="/methods/ai-workflow-evidence-protocol/">Read the outcome method</a></div></section>}
  <section class="section-space"><h2>Outcome anatomy</h2><div class="requirement-grid"><article><strong>Baseline</strong><p>Numeric value, unit, sample, date window, collection method.</p></article><article><strong>Result</strong><p>Same unit and compatible window, plus cost, quality and safety guardrails.</p></article><article><strong>Decision</strong><p>Human owner, stop/revise/pilot/deploy decision, overrides and reversals.</p></article><article><strong>Evidence</strong><p>Method version, source manifest, privacy result, reviewer scope, limitations.</p></article></div></section></div>
</BaseLayout>
