---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { pilotPackages, pilotReadyRelease } from '../../data/pilot-ready-release.mjs';
const subject = encodeURIComponent(`AI Amigos ${pilotReadyRelease.id} - governed pilot inquiry`);
const body = encodeURIComponent('Pilot package slug:\nU.S. connection:\nParticipant type:\nBounded job:\nBaseline metric and sample:\nDecision-owner role:\nExternal verification domain (optional):\nPublication preference: private-only / anonymous / named\n\nDo not attach confidential, regulated, student, employer, customer, credential, or security data.');
---
<BaseLayout title="Participate in a governed AI pilot" description="Four privacy-conscious pilot packages with eligibility, baselines, responsibilities, consent choices, and downloadable evidence templates.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Governed participation · {pilotReadyRelease.id}</p><h1>Run a real test without turning private work into a public claim.</h1><p class="lede">Choose a package, pre-register the baseline and stop criteria, keep raw data under participant control, and decide separately whether any sanitized record may be reviewed or published.</p><div class="notice"><strong>Current status:</strong> applications are invitations to assess fit. They are not adoptions, field studies, endorsements, outcomes, or independent evidence.</div><div class="button-row"><a class="button" href={`mailto:${site.email}?subject=${subject}&body=${body}`}>Email structured pilot inquiry</a><a class="button secondary" href="/pilot-kit/participant-checklist.md" download>Download checklist</a></div></section>
  <div class="method-list">{pilotPackages.map((pilot, index) => <article class="method-row" id={pilot.slug}><div class="method-number">0{index + 1}</div><div><p class="eyebrow">{pilot.track}</p><h2>{pilot.title}</h2><p><strong>Eligibility:</strong> {pilot.eligible}</p><p><strong>Baseline and sample:</strong> {pilot.sample}</p><p><strong>Participant responsibility:</strong> {pilot.responsibility}</p><h3>Never submit</h3><ul>{pilot.forbidden.map((item) => <li>{item}</li>)}</ul></div><a class="text-link" href={`mailto:${site.email}?subject=${encodeURIComponent(`AI Amigos pilot - ${pilot.slug}`)}&body=${body}`}>Ask about this pilot →</a></article>)}</div>
  <section class="split-section section-space"><div><h2>Consent and publication choices</h2><ol><li><strong>Private-only:</strong> no public record and no inclusion in aggregation.</li><li><strong>Sanitized anonymous:</strong> a separately reviewed record may omit participant and organization names.</li><li><strong>Named:</strong> publication requires explicit authorization and participant-controlled verification.</li></ol><p>Consent can be withheld or withdrawn before publication. A published correction or withdrawal remains visible in the history.</p></div><div><h2>Download the working records</h2><p><a href="/pilot-kit/pilot-preregistration.template.json" download>Pilot pre-registration JSON</a></p><p><a href="/pilot-kit/proof-pack-submission.template.json" download>Proof-pack submission JSON</a></p><p><a href="/pilot-kit/participant-checklist.md" download>Participant checklist</a></p><p><a href="/methods/ai-workflow-evidence-protocol/">Read the controlling method →</a></p></div></section></div>
</BaseLayout>
