---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { playbooks } from '../../../data/outcome-network.mjs';
export function getStaticPaths() { return playbooks.map((playbook) => ({ params:{ slug:playbook.slug }, props:{ playbook } })); }
const { playbook } = Astro.props;
const schema = { '@context':'https://schema.org', '@type':'HowTo', name:playbook.title, description:playbook.summary, dateModified:playbook.reviewedAt, step:playbook.method.map((text, index) => ({ '@type':'HowToStep', position:index+1, text })) };
---
<BaseLayout title={playbook.title} description={playbook.summary} schema={schema}>
  <div class="shell" data-pagefind-filter="type:Playbook"><Breadcrumbs items={[{href:'/playbooks/',label:'Playbooks'}]} /><article data-pagefind-body data-pagefind-filter={`track:${playbook.track}`}><header class="protocol-header"><div><p class="eyebrow">{playbook.track} · reviewed protocol</p><h1>{playbook.title}</h1><p class="lede">{playbook.summary}</p><div class="button-row" data-pagefind-ignore><a class="button" href={`/app/?playbook=${playbook.slug}`}>Fork into workbench</a><a class="button secondary" href={`/playbooks/${playbook.slug}/`}>Share stable link</a></div></div><dl class="protocol-meta"><div><dt>Version</dt><dd>{playbook.version}</dd></div><div><dt>Reviewed</dt><dd>{playbook.reviewedAt}</dd></div><div><dt>Next review</dt><dd>{playbook.nextReviewAt}</dd></div><div><dt>Reviewer</dt><dd>{playbook.reviewer}</dd></div><div><dt>Scope</dt><dd>{playbook.reviewerScope}</dd></div></dl></header>
  <div class="protocol-layout"><div><section><p class="eyebrow">Job to be done</p><h2>{playbook.jobToBeDone}</h2><p class="notice"><strong>Evidence state:</strong> {playbook.sample}</p></section><section><h2>Baseline</h2><ol>{playbook.baseline.map((item) => <li>{item}</li>)}</ol></section><section><h2>Method</h2><ol>{playbook.method.map((item) => <li>{item}</li>)}</ol></section><section><h2>Evaluation</h2><ul>{playbook.evaluation.map((item) => <li>{item}</li>)}</ul></section><section><h2>Limitations</h2><ul>{playbook.limitations.map((item) => <li>{item}</li>)}</ul></section></div><aside class="evidence-ledger"><h2>Evidence ledger</h2><dl><div><dt>Protocol version</dt><dd>{playbook.version}</dd></div><div><dt>Outcome reports</dt><dd>0 public</dd></div><div><dt>Benchmark status</dt><dd>Suppressed</dd></div><div><dt>Raw inputs public</dt><dd>No</dd></div></dl><h3>Authoritative references</h3><ol>{playbook.sources.map((source) => <li><a href={source} rel="external">{new URL(source).hostname}</a></li>)}</ol><h3>Revision history</h3>{playbook.revisions.map((revision) => <p><strong>{revision.version}</strong> · {revision.date}<br />{revision.note}</p>)}</aside></div></article></div>
</BaseLayout>
