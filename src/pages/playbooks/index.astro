---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionFilters from '../../components/CollectionFilters.astro';
import { playbooks } from '../../data/outcome-network.mjs';
import { tracks } from '../../data/tracks.mjs';
---
<BaseLayout title="Reviewed AI playbooks" description="Versioned operational protocols with baselines, evaluation methods, reviewer scope, and visible limitations.">
  <div class="shell"><section class="hero reading"><p class="eyebrow">Reviewed playbook library</p><h1>Start from a testable protocol, then report what happened.</h1><p class="lede">These records define a method. They do not claim community outcomes. Fork one into your private workbench, run it on your context, and keep the failures as part of the evidence.</p></section>
  <CollectionFilters id="playbook-browser" total={playbooks.length} singular="playbook" plural="playbooks" searchLabel="Find a playbook by task" filters={[{name:'track',label:'Track',allLabel:'All tracks',options:tracks.map((track)=>({value:track.slug,label:track.label}))}]}><div class="record-table" role="region" aria-label="Reviewed playbooks" tabindex="0" data-filter-results><table><thead><tr><th>Playbook</th><th>Track</th><th>Version</th><th>Reviewed</th><th>Evidence state</th></tr></thead><tbody>{playbooks.map((item) => <tr data-filter-item data-search={`${item.title} ${item.summary} ${item.jobToBeDone}`} data-track={item.track}><td><a href={`/playbooks/${item.slug}/`}><strong>{item.title}</strong></a><small>{item.summary}</small></td><td>{item.track}</td><td>{item.version}</td><td>{item.reviewedAt}</td><td><span class="status reviewed">Reviewed protocol</span><small>{item.sample}</small></td></tr>)}</tbody></table></div></CollectionFilters>
  <aside class="evidence section-space"><strong>Publication boundary.</strong> A future community playbook must include a sanitized proof pack, named review, evidence lineage, limitations, correction history, and explicit consent. Raw prompts, artifacts, organization names, student records, and confidential inputs are prohibited.</aside></div>
</BaseLayout>
