import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Search tools, templates, tracks, playbooks, and guides" description="Full-text, faceted search across the practical AI Amigos workbench."><div class="shell search-shell"><div class="reading"><p class="eyebrow">Full-text resource search</p><h1>Find the next useful action.</h1><p class="lede">Browse the complete practical index or search by task. Resource-type and track filters can be combined, and inactive feeds never appear as current content.</p></div><div class="pagefind-workspace" aria-label="Search AI Amigos"><pagefind-config faceted preload></pagefind-config><pagefind-input placeholder="Search by task, evidence, or title…"></pagefind-input><div class="pagefind-filter-row"><pagefind-filter-dropdown filter="type" label="Resource type" single-select></pagefind-filter-dropdown><pagefind-filter-dropdown filter="track" label="Track" single-select></pagefind-filter-dropdown></div><pagefind-summary></pagefind-summary><pagefind-results show-sub-results></pagefind-results></div><noscript><p class="notice">Search needs JavaScript. Browse <a href="/tools/">tools</a>, <a href="/templates/">templates</a>, <a href="/playbooks/">playbooks</a>, or <a href="/tracks/">tracks</a> instead.</p></noscript></div><link href="/pagefind/pagefind-component-ui.css" rel="stylesheet"><script type="module" src="/pagefind/pagefind-component-ui.js"></script></BaseLayout>
