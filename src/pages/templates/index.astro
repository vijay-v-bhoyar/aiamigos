---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionFilters from '../../components/CollectionFilters.astro';
import { tracks } from '../../data/tracks.mjs';
import { templates } from '../../data/templates.mjs';
---
<BaseLayout title="Practical AI templates" description="Twenty reviewed, copyable templates for AI business pilots, careers, teaching, and technical evaluation."><div class="shell"><div class="reading"><p class="eyebrow">Reusable work products</p><h1>Twenty templates you can actually fill in.</h1><p class="lede">Copy Markdown, print a clean worksheet, or adapt the structure to your organization. No account is needed.</p></div><CollectionFilters id="template-browser" total={templates.length} singular="template" plural="templates" searchLabel="Find a template by task" filters={[{name:'track',label:'Track',allLabel:'All tracks',options:tracks.map((track)=>({value:track.slug,label:track.label}))}]}><div class="article-grid" data-filter-results>{templates.map((item) => <article class="article-card" data-filter-item data-search={`${item.title} ${item.purpose} ${item.sections.join(' ')}`} data-track={item.track}><span class="tag">{item.track}</span><h2><a href={`/templates/${item.slug}/`}>{item.title}</a></h2><p>{item.purpose}</p><span class="meta">Copyable Markdown · reviewed structure</span></article>)}</div></CollectionFilters></div></BaseLayout>
