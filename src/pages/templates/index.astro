---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tracks } from '../../data/tracks.mjs';
import { templates } from '../../data/templates.mjs';
---
<BaseLayout title="Practical AI templates" description="Twenty reviewed, copyable templates for AI business pilots, careers, teaching, and technical evaluation."><div class="shell"><div class="reading"><p class="eyebrow">Reusable work products</p><h1>Twenty templates you can actually fill in.</h1><p class="lede">Copy Markdown, print a clean worksheet, or adapt the structure to your organization. No account is needed.</p></div>{tracks.map((track) => <section class="section-space"><h2>{track.label}</h2><div class="article-grid">{templates.filter((item) => item.track === track.slug).map((item) => <article class="article-card"><h3><a href={`/templates/${item.slug}/`}>{item.title}</a></h3><p>{item.purpose}</p><span class="meta">Copyable Markdown · reviewed structure</span></article>)}</div></section>)}</div></BaseLayout>
