---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ToolRunner from '../../../components/ToolRunner.astro';
import { tools } from '../../../data/tools.mjs';
import { templateBySlug } from '../../../data/templates.mjs';
export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const schema = { '@context':'https://schema.org', '@type':'WebApplication', name:tool.title, description:tool.summary, url:`https://www.aiamigos.org/tools/${tool.slug}/`, applicationCategory:'BusinessApplication', operatingSystem:'Any modern browser', isAccessibleForFree:true, offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}, featureList:['No login','Runs locally in the browser','Markdown, JSON, and CSV export','Human approval checks'] };
---
<BaseLayout title={tool.title} description={tool.summary} schema={schema}>
  <div class="shell"><Breadcrumbs items={[{href:'/tools/',label:'Tools'}]} /><header class="article-header reading" data-pagefind-body data-pagefind-filter={`track:${tool.track}`}><span class="tag">{tool.track}</span><h1>{tool.title}</h1><p class="lede">{tool.summary}</p><p class="meta">About {tool.estimatedMinutes} minutes · no account · no model API · reviewed 2026-08-22</p></header>
  <div class="workbench-layout"><ToolRunner tool={tool} /><aside class="tool-aside"><h2>What you get</h2><p>{tool.outcome}</p><h2>Before you begin</h2><p>Describe the process, not confidential records. The tool cannot approve a vendor or replace organizational review.</p><p><a class="button secondary" href={`/app/?track=${tool.track}&starter=${tool.slug}`}>Attach to a project</a></p></aside></div>
  <section class="reading section-space"><h2>Worked example</h2><p>Use a bounded task such as “summarize weekly support themes” or “evaluate a citation-enabled policy assistant.” The generated result names assumptions, checks, and human decisions so another person can review the plan.</p><h2>Limitations</h2><ul>{tool.limitations.map((item) => <li>{item}</li>)}</ul><h2>Supporting evidence</h2><ul>{tool.sources.map((source) => <li><a href={source} rel="external">{new URL(source).hostname}</a></li>)}</ul><h2>Continue with a template</h2><ul>{tool.templateSlugs.map((slug) => <li><a href={`/templates/${slug}/`}>{templateBySlug[slug].title}</a></li>)}</ul><h2>Questions people ask</h2><h3>Does AI Amigos receive my answers?</h3><p>No. The calculations run in your browser and local saving uses browser storage.</p><h3>Can I share my result?</h3><p>Export the result intentionally. “Share this tool” copies only this stable page address and never includes your inputs.</p></section></div>
</BaseLayout>
