---
import { getCollection } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import ArticleCard from '../../../components/ArticleCard.astro'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import { tracks } from '../../../data/tracks.mjs'; import { toolBySlug } from '../../../data/tools.mjs'; import { templateBySlug } from '../../../data/templates.mjs';
export function getStaticPaths(){return tracks.map((track)=>({params:{slug:track.slug},props:{track}}));} const {track}=Astro.props; const tool=toolBySlug[track.toolSlug];
const categoryMap={business:['foundations','industry-applications','responsible-ai'],careers:['careers'],teaching:['foundations','responsible-ai'],builders:['ai-engineering','tools-and-models']}; const articles=(await getCollection('articles',({data})=>data.status==='published'&&categoryMap[track.slug].includes(data.category))).slice(0,6);
---
<BaseLayout title={track.label} description={track.description}><div class="shell"><Breadcrumbs items={[{href:'/tracks/',label:'Tracks'}]} /><div class="reading" data-pagefind-body data-pagefind-filter={`track:${track.slug}`}><p class="eyebrow">Practical track</p><h1>{track.label}</h1><p class="lede">{track.description}</p></div><section class="journey section-space"><div><span>1</span><h2>Decide</h2><p>Define the job, acceptable evidence, privacy boundary, and human owner.</p></div><div><span>2</span><h2>Build</h2><p>Use the private workbench and a template to produce a reviewable result.</p></div><div><span>3</span><h2>Test</h2><p>Compare the result with your baseline, record failures, and decide whether to proceed.</p></div></section><section class="feature-panel"><div><p class="eyebrow">Recommended tool</p><h2>{tool.title}</h2><p>{tool.summary}</p><a class="button" href={`/tools/${tool.slug}/`}>Use the tool</a></div><div><h2>Template set</h2><ul>{track.templateSlugs.map((slug)=><li><a href={`/templates/${slug}/`}>{templateBySlug[slug].title}</a></li>)}</ul></div></section><section class="section-space"><div class="section-head"><h2>Supporting guides</h2><a href="/articles/">Filter all guides</a></div><div class="article-grid">{articles.map((article)=><ArticleCard article={article}/>)}</div></section></div></BaseLayout>
